---
// Category tile with image, used on the home page and /categories/.
import { categoryImage, type Category } from '../lib/data';
interface Props { c: Category; count?: string; eager?: boolean }
const { c, count, eager = false } = Astro.props;
const fallback = `/img/categories/${c.slug}.svg`;
const img = categoryImage(c);
---
<a href={`/categories/${c.slug}/`} class="cat">
  <span class="cat-img">
    <img src={img} alt={c.image_alt ?? ''} width="600" height="400" loading={eager ? 'eager' : 'lazy'} decoding="async"
      onerror={img !== fallback ? `this.onerror=null;this.src='${fallback}'` : undefined} />
  </span>
  <b>{c.name}</b>
  {count && <span class="muted cat-count">{count}</span>}
</a>
<style>
  .cat { text-decoration: none; display: flex; flex-direction: column; gap: 8px; color: var(--ink); }
  .cat-img { display: block; aspect-ratio: 3 / 2; border-radius: 16px; overflow: hidden; background: var(--rose-soft); }
  .cat-img img { width: 100%; height: 100%; object-fit: cover; transition: transform .3s ease; }
  .cat:hover .cat-img img { transform: scale(1.04); }
  .cat b { font-size: 16px; }
  .cat:hover b { color: var(--rose-dark); }
  .cat-count { font-size: 13px; margin-top: -4px; }
  @media (prefers-reduced-motion: reduce) { .cat-img img { transition: none; } }
</style>
