---
// Shared body of /blog/ and /blog/category/<slug>/ (with pagination).
import PostCard from './PostCard.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import { getData, type Post, type BlogCategory } from '../lib/data';
interface Props { posts: Post[]; pageNo: number; pages: number; base: string; heading: string; intro: string; current?: BlogCategory; crumbs: { name: string; url?: string }[] }
const { posts, pageNo, pages, base, heading, intro, current, crumbs } = Astro.props;
const d = await getData();
const pageUrl = (n: number) => (n === 1 ? base : `${base}page/${n}/`);
---
<main class="wrap" style="padding-top:24px">
  <Breadcrumbs items={crumbs} />
  <h1 class="serif" style="font-size:clamp(36px,5vw,52px);margin:16px 0 8px">{heading}{pageNo > 1 && <span class="muted" style="font-size:.5em"> · page {pageNo}</span>}</h1>
  <p class="muted" style="font-size:17px;max-width:760px;margin:0 0 20px">{intro}</p>
  <nav class="blog-cats" aria-label="Blog categories">
    <a href="/blog/" aria-current={!current ? 'page' : undefined}>All</a>
    {d.blogCategories.map((c) => <a href={d.urls.blogCategory(c)} aria-current={current?.id === c.id ? 'page' : undefined}>{c.name}</a>)}
  </nav>
  {posts.length ? <div class="post-grid">{posts.map((p) => <PostCard p={p} />)}</div> : <p class="muted">No articles here yet. Check back soon.</p>}
  {pages > 1 && (
    <nav class="pager" aria-label="Pages">
      {pageNo > 1 && <a class="btn btn-outline" href={pageUrl(pageNo - 1)} rel="prev">← Newer</a>}
      <span class="muted">Page {pageNo} of {pages}</span>
      {pageNo < pages && <a class="btn btn-outline" href={pageUrl(pageNo + 1)} rel="next">Older →</a>}
    </nav>
  )}
</main>
<style>
  .blog-cats { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 28px; }
  .blog-cats a { padding: 8px 14px; border: 1px solid var(--line); border-radius: 999px; text-decoration: none; font-size: 14px; font-weight: 500; }
  .blog-cats a[aria-current] { background: var(--ink); color: #fff; border-color: var(--ink); }
  .post-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px; }
  .pager { display: flex; gap: 16px; align-items: center; justify-content: center; margin: 40px 0 0; }
</style>
