---
import { fmtDay } from '../../lib/content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import VendorCard from '../../components/VendorCard.astro';
import { getData, money, replyLabel, rankVendors, telHref, categoryImage, type Vendor } from '../../lib/data';
import { vendorJsonLd, breadcrumbJsonLd, faqJsonLd } from '../../lib/seo';
import { cleanDetails, filledGroups, showValue } from '../../lib/details';

export async function getStaticPaths() {
  const d = await getData();
  return d.vendors.map((v) => ({ params: { slug: v.slug }, props: { v } }));
}

interface Props { v: Vendor }
const { v } = Astro.props;
const d = await getData();
const city = d.cityById.get(v.city_id)!;
const region = d.regionById.get(city.region_id)!;
const cat = d.categoryById.get(v.category_id)!;
const listing = d.listings.find((l) => l.city.id === city.id && l.category.id === cat.id)!;
const photos = d.photosByVendor.get(v.id) ?? [];
const packages = d.packagesByVendor.get(v.id) ?? [];
const reviews = (d.reviewsByVendor.get(v.id) ?? []).slice(0, 10);
const similar = rankVendors(listing.vendors.filter((x) => x.id !== v.id)).slice(0, 3);   // for "also send to similar"
const nearby = d.nearbyFor(v, 6);
const team = d.teamFor(v, 6);
const plural = cat.name.toLowerCase();
const reply = replyLabel(v.avg_reply_minutes);
const st = region.code.toUpperCase();
const crumbs = [
  { name: 'Home', url: '/' },
  { name: region.name, url: d.urls.region(region) },
  { name: city.name, url: d.urls.city(city) },
  { name: cat.name, url: listing.url },
  { name: v.name },
];
const singular = cat.singular.toLowerCase();
const article = /^[aeiou]/i.test(singular) ? 'an' : 'a';
const where = `${city.name}, ${region.name}`;
const desc = v.description?.trim()
  ? `${v.description.trim().slice(0, 140)}… Request pricing and availability.`
  : `${v.name} is ${article} ${singular} in ${where}.${v.phone ? ` Phone ${v.phone}.` : ''} See location, contact details and similar ${plural} nearby, and request pricing for your date.`;
const webHost = v.website ? (() => { try { return new URL(v.website!).host.replace(/^www\./, ''); } catch { return null; } })() : null;
const others = listing.vendors.length - 1;
const about = v.description?.trim() || [
  `${v.name} is ${article} ${singular} based in ${where}${v.address ? `, at ${v.address}` : ''}.`,
  `Couples planning a wedding in ${city.name} can contact them directly${v.phone ? ` on ${v.phone}` : ''}${webHost ? ` or through their website, ${webHost}` : ''}, or send one request here to check pricing and availability for their date.`,
  others > 0 ? `To compare options, browse ${others} other ${plural} in ${city.name}.` : '',
].filter(Boolean).join(' ');
const det = cleanDetails(cat.slug, v.details);
const detGroups = filledGroups(cat.slug, det);
const detList = (k: string) => (Array.isArray(det[k]) ? (det[k] as string[]) : []);
const faqs = [
  { q: `Where is ${v.name} located?`, a: v.address ? `${v.name} is at ${v.address}, ${city.name}, ${st}${v.zip ? ` ${v.zip}` : ''}.` : `${v.name} is based in ${city.name}, ${region.name}.` },
  ...(v.phone || webHost ? [{ q: `How do I contact ${v.name}?`, a: [v.phone && `Call ${v.phone}`, webHost && `visit ${webHost}`].filter(Boolean).join(' or ') + `, or use the "Check availability & pricing" form on this page to send your date and guest count.` }] : []),
  { q: `How much does ${v.name} cost?`, a: v.price_from != null ? `Pricing starts from ${money(v.price_from)}. Final prices depend on your date, guest count and package; request a quote for an exact price.` : `${v.name} hasn't published prices yet. Send a free request with your date and guest count to get a quote.` },
  ...(cat.uses_capacity && (v.capacity_max || det.capacity_seated) ? [{ q: `How many guests can ${v.name} host?`, a: [
    v.capacity_max && `Up to ${v.capacity_max} guests.`, det.capacity_seated && `${det.capacity_seated} for a seated dinner.`,
    det.capacity_standing && `${det.capacity_standing} cocktail-style.`, det.capacity_min && `Minimum ${det.capacity_min} guests.`].filter(Boolean).join(' ') }] : []),
  ...(det.catering_policy ? [{ q: `Can we bring our own caterer to ${v.name}?`, a: `${det.catering_policy}.${det.alcohol_policy ? ` Alcohol: ${String(det.alcohol_policy).toLowerCase()}.` : ''}` }] : []),
  ...(detList('services').length ? [{ q: `What services does ${v.name} offer?`, a: `${detList('services').join(', ')}.` }] : []),
  ...(detList('amenities').includes('Wheelchair accessible') ? [{ q: `Is ${v.name} wheelchair accessible?`, a: `Yes, ${v.name} lists the venue as wheelchair accessible. Ask about specific needs when you request pricing.` }] : []),
  ...(detList('languages').length > 1 ? [{ q: `What languages does ${v.name} speak?`, a: `${detList('languages').join(', ')}.` }] : []),
];
const updated = v.updated_at;
const fmtDate = (s: string | null) => (s ? new Date(s).toLocaleDateString('en-US', { month: 'short', year: 'numeric' }) : '');
const today = new Date().toISOString().slice(0, 10);
// "At a glance": the key facts in one box near the top, one short line each (same idea as the listing pages).
const listOf = (k: string) => (Array.isArray(det[k]) ? (det[k] as string[]) : []);
const lc = (x: string) => x.charAt(0).toLowerCase() + x.slice(1);
const joinList = (xs: string[], max = 4, keepCase = false) => {
  const a = xs.slice(0, max).map((x) => (keepCase ? x : lc(x)));
  const more = xs.length > max ? ` +${xs.length - max} more` : '';
  return a.join(', ') + more;   // commas, not "and": many option names already contain "&" 
};
const minPkg = packages.map((p) => p.price).filter((x): x is number => x != null).sort((a, b) => a - b)[0];
const kindList = [...listOf('venue_type'), ...listOf('styles'), ...listOf('act_type'), ...listOf('products'), ...listOf('cuisines'), ...listOf('vehicles'), ...listOf('booth_types')];
const offerList = [...listOf('services'), ...listOf('items'), ...listOf('features')];
const glanceRows = [
  ['Price', v.price_from != null ? `From ${money(v.price_from)}` : minPkg != null ? `Packages from ${money(minPkg)}` : 'Prices on request',
    typeof det.spend_peak === 'number' ? `couples usually spend about ${money(det.spend_peak)}` : ''],
  cat.uses_capacity && (v.capacity_max || det.capacity_seated) && ['Guests', [v.capacity_max && `Up to ${v.capacity_max}`,
    det.capacity_seated && `${det.capacity_seated} seated`, det.capacity_min && `minimum ${det.capacity_min}`].filter(Boolean).join(' · '), ''],
  (kindList.length || v.setting) && ['Style', [joinList(kindList, 3), v.setting].filter(Boolean).join(' · ').replace(/^./, (x) => x.toUpperCase()), ''],
  offerList.length > 0 && ['Offers', joinList(offerList).replace(/^./, (x) => x.toUpperCase()), ''],
  (det.catering_policy || det.alcohol_policy) && ['Food & drink', [det.catering_policy, det.alcohol_policy].filter(Boolean).join(' · '), ''],
  (det.coverage || det.turnaround || det.hours) && ['Booking', [det.coverage || det.hours, det.turnaround && `delivery ${lc(String(det.turnaround))}`].filter(Boolean).join(' · '), ''],
  det.travel && ['Travel', String(det.travel), ''],
  v.rating && ['Reviews', `★ ${Number(v.rating).toFixed(1)} from ${v.review_count} review${v.review_count === 1 ? '' : 's'}`, ''],
  reply && ['Replies', `Usually within ${reply}`, ''],
  (typeof det.years_in_business === 'number' || listOf('languages').length > 1) && ['Business', [typeof det.years_in_business === 'number' && `${det.years_in_business} years in business`,
    listOf('languages').length > 1 && `speaks ${joinList(listOf('languages'), 3, true)}`].filter(Boolean).join(' · '), ''],
].filter(Boolean) as [string, string, string][];
// Old free-text amenities: only show the ones the structured details don't already list.
const detAmen = new Set([...listOf('amenities'), ...offerList].map((x) => x.toLowerCase()));
const extraAmenities = v.amenities.filter((a) => !detAmen.has(a.toLowerCase()));
---
<Base title={`${v.name} – ${cat.singular} in ${city.name}, ${st}`} description={desc} noindex={!d.vendorIndexable(v)} image={photos[0]?.url}
  jsonld={[vendorJsonLd(Astro.site, d, v), breadcrumbJsonLd(Astro.site, crumbs), faqJsonLd(faqs)]}>
  <main class="wrap" style="padding-top:20px" data-vendor-page={v.id}>
    <Breadcrumbs items={crumbs} />
    {photos.length > 0 ? (
      <div class:list={['gallery', `n${Math.min(photos.length, 5)}`]}>
        {photos.slice(0, 5).map((p, i) => <img src={p.url} alt={p.alt ?? `${v.name} photo ${i + 1}`} class={i === 0 ? 'big' : ''} loading={i === 0 ? 'eager' : 'lazy'} width="600" height="400" />)}
      </div>
    ) : (
      <div class="banner-ill">
        <img src={categoryImage(cat)} alt="" width="600" height="400" fetchpriority="high" />
        <div class="banner-note">
          <b>Photos coming soon</b>
          {v.status === 'unclaimed'
            ? <span>Is this your business? <a href={`/for-vendors/?claim=${v.id}`}>Claim it free</a> to add photos, prices and reply to couples.</span>
            : <span>Ask {v.name} for photos of past weddings when you request pricing.</span>}
        </div>
      </div>
    )}

    <div class="layout">
      <div class="main">
        <div style="display:flex;flex-direction:column;gap:12px">
          <div style="display:flex;flex-wrap:wrap;gap:8px">
            {v.status === 'claimed' && <span class="badge badge-green">✓ Verified owner</span>}
            {v.featured && <span class="badge badge-rose">Featured</span>}
          </div>
          <h1 class="serif" style="font-size:clamp(38px,5vw,56px);margin:0;line-height:1">{v.name}</h1>
          <div style="display:flex;flex-wrap:wrap;gap:8px 16px;font-size:15px;color:var(--ink-2)">
            {v.rating && <span><b style="color:var(--ink)">★ {Number(v.rating).toFixed(1)}</b> ({v.review_count} reviews)</span>}
            <span><a href={listing.url}>{cat.singular}</a> in <a href={d.urls.city(city)}>{city.name}, {st}</a></span>
          </div>
          <div class="contact">
            {v.phone && <a class="btn btn-outline" href={telHref(v.phone)} data-track="click_phone">Call {v.phone}</a>}
            {v.website && <a class="btn btn-outline" href={v.website} target="_blank" rel="noopener nofollow" data-track="click_website">Website ↗</a>}
            {v.address && <a class="btn btn-outline" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${v.name} ${v.address} ${city.name} ${st}`)}`} target="_blank" rel="noopener" data-track="click_directions">Directions</a>}
            <button type="button" class="icon-btn" data-shortlist={v.id} data-name={v.name} data-url={d.urls.vendor(v)} aria-pressed="false" aria-label="Save to shortlist">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 21s-7-4.4-9.3-9C1 8.6 3.2 5 6.6 5c2 0 3.3 1.1 4.1 2.4C11.6 6.1 13 5 15 5c3.4 0 5.6 3.6 3.9 7-2.3 4.6-6.9 9-6.9 9z"/></svg>
            </button>
          </div>
        </div>

        <section class="vglance" aria-labelledby="vglance-h">
          <h2 id="vglance-h">At a glance</h2>
          <dl>{glanceRows.map(([k, val, sub]) => <div><dt>{k}</dt><dd>{val}{sub && <span class="muted">, {sub}</span>}</dd></div>)}</dl>
          {v.status === 'unclaimed' && <p class="vglance-note">Details come from public business listings. <a href={`/for-vendors/?claim=${v.id}`}>Own {v.name}? Claim it</a> to add prices, capacity and photos.</p>}
        </section>

        <nav class="tabs" aria-label="Profile sections">
          <a href="#about">About</a>{detGroups.length > 0 && <a href="#details">Details</a>}<a href="#location">Location</a>{packages.length > 0 && <a href="#pricing">Pricing</a>}<a href="#reviews">Reviews</a><a href="#faqs">FAQs</a>
        </nav>

        <section id="about">
          <h2 class="serif">About {v.name}</h2>
          <p style="font-size:16px;line-height:1.65;color:#3a3447;white-space:pre-line">{about}</p>
          {extraAmenities.length > 0 && <ul class="amen">{extraAmenities.map((a) => <li>{a}</li>)}</ul>}
        </section>

        {detGroups.length > 0 && (
          <section id="details">
            <h2 class="serif">Details &amp; amenities</h2>
            {detGroups.map((g) => (
              <div class="det-group">
                <h3>{g.title}</h3>
                {g.fields.map(({ field, value }) => Array.isArray(value)
                  ? <div class="det-row"><b>{field.label}</b><ul class="amen">{value.map((x) => <li>{x}</li>)}</ul></div>
                  : <div class="det-row det-inline"><b>{field.label}</b><span>{showValue(field, value)}</span></div>)}
              </div>
            ))}
          </section>
        )}

        <section id="location">
          <h2 class="serif">Location &amp; contact</h2>
          <address class="nap">
            <b>{v.name}</b>
            <span>{v.address && <>{v.address}<br /></>}{city.name}, {region.name}{v.zip && ` ${v.zip}`}</span>
            {v.phone && <span>Phone: <a href={telHref(v.phone)} data-track="click_phone">{v.phone}</a></span>}
            {webHost && <span>Website: <a href={v.website!} target="_blank" rel="noopener nofollow" data-track="click_website">{webHost}</a></span>}
          </address>
          <p class="updated">Listing last updated <time datetime={updated}>{fmtDay(updated)}</time></p>
        </section>

        {packages.length > 0 && (
          <section id="pricing">
            <h2 class="serif">Packages &amp; pricing</h2>
            <div class="pkgs">
              {packages.map((p) => (
                <div class="pkg"><b>{p.name}</b><span class="serif" style="font-size:26px">{p.price != null ? money(p.price) : 'Ask for pricing'}</span>
                {p.description && <span class="muted" style="font-size:14px">{p.description}</span>}
                <a href="#lead" style="font-weight:600;font-size:14px;color:var(--rose-dark)">Check this date →</a></div>
              ))}
            </div>
          </section>
        )}

        <section id="reviews">
          <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:12px;flex-wrap:wrap">
            <h2 class="serif">Reviews</h2>
            <details class="write-review"><summary class="btn btn-outline">Write a review</summary>
              <form id="review-form" class="review-form">
                <label class="field">Your name(s)<input name="name" required maxlength="80" /></label>
                <label class="field">Email (not shown)<input name="email" type="email" required /></label>
                <label class="field">Wedding date<input name="date" type="date" max={today} /></label>
                <label class="field">Rating<select name="rating" required><option value="5">5 – Excellent</option><option value="4">4 – Great</option><option value="3">3 – Good</option><option value="2">2 – Fair</option><option value="1">1 – Poor</option></select></label>
                <label class="field">Your review<textarea name="body" rows="4" required minlength="20" maxlength="4000"></textarea></label>
                <p class="form-error" role="alert"></p>
                <button class="btn btn-primary" type="submit">Submit review</button>
              </form>
            </details>
          </div>
          {reviews.length ? reviews.map((r) => (
            <article class="review">
              <div style="display:flex;gap:12px;align-items:center"><span class="avatar" aria-hidden="true">{r.author_name[0]}</span>
              <div style="display:flex;flex-direction:column"><b style="font-size:15px">{r.author_name}</b><span class="muted" style="font-size:13px">{r.wedding_date && `Married ${fmtDate(r.wedding_date)} · `}★ {r.rating}.0</span></div></div>
              <p>{r.body}</p>
            </article>
          )) : <p class="muted">No reviews yet. Worked with {v.name}? Be the first to review.</p>}
        </section>

        <section id="faqs">
          <h2 class="serif">{v.name}: FAQs</h2>
          {faqs.map((f, i) => <details class="faq" open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>)}
        </section>

        {v.status === 'unclaimed' && (
          <p class="claim">Is this your business? <a href={`/for-vendors/?claim=${v.id}`}>Claim this listing</a> to add photos, pricing and reply to couples.</p>
        )}

        {nearby.length > 0 && (
          <section aria-labelledby="nearby-h">
            <h2 class="serif" id="nearby-h">More {plural} near {city.name}</h2>
            <p class="muted" style="margin:-8px 0 16px">Popular with couples in and around {city.name}.</p>
            <div class="card-grid">{nearby.map((s, i) => <VendorCard v={s} index={i + 1} />)}</div>
            <p><a href={listing.url}>See all {listing.vendors.length} {plural} in {city.name} →</a></p>
          </section>
        )}
        {team.length > 0 && (
          <section aria-labelledby="team-h">
            <h2 class="serif" id="team-h">Complete your wedding team in {city.name}</h2>
            <div class="card-grid">{team.map((s, i) => <VendorCard v={s} index={i + 1} showCategory />)}</div>
          </section>
        )}
      </div>

      <aside id="lead" class="lead" aria-label="Request pricing">
        <form id="lead-form" class="lead-card" data-source="profile" data-vendor={v.id} data-city={city.id}>
          <button type="button" class="icon-btn lead-close" aria-label="Close" data-lead-close>✕</button>
          <div>
            <span class="serif" style="font-size:30px;line-height:1.1;display:block">Check availability &amp; pricing</span>
            <span style="font-size:14px;color:var(--green);font-weight:600">Free{reply && ` · usually replies within ${reply}`}</span>
          </div>
          <div class="two">
            <label class="field">Wedding date<input type="date" name="wedding_date" min={today} /></label>
            <label class="field">Guests<input type="number" name="guests" min="1" max="3000" inputmode="numeric" placeholder="150" /></label>
          </div>
          <label class="check"><input type="checkbox" name="date_flexible" /> Our date is flexible</label>
          <label class="field">Full name<input name="couple_name" required maxlength="120" autocomplete="name" /></label>
          <label class="field">Email<input type="email" name="email" required autocomplete="email" /></label>
          <label class="field">Phone (optional, for faster replies)<input type="tel" name="phone" autocomplete="tel" inputmode="tel" placeholder="(212) 423-0172" maxlength="30" /></label>
          <label class="field">Message<textarea name="message" rows="3">Hi! We're planning our wedding and would love to know your pricing and availability for our date.</textarea></label>
          <label class="hp" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label>
          {similar.length > 0 && <label class="check similar"><input type="checkbox" name="also_similar" checked /><span><b>Also send to {Math.min(3, similar.length)} similar {cat.name.toLowerCase()}</b> with my date open. Compare more quotes with no extra effort.</span></label>}
          <p class="form-error" role="alert"></p>
          <button type="submit" class="btn btn-primary btn-lg">Send request</button>
          <span class="muted" style="font-size:12px;text-align:center">By sending you agree to our <a href="/terms/">Terms</a>. Only the vendors you contact see your details.</span>
        </form>
      </aside>
    </div>
  </main>
  <div class="mbar">
    {v.phone && <a class="icon-btn" href={telHref(v.phone)} data-track="click_phone" aria-label={`Call ${v.name}`}>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg></a>}
    <a href="#lead" class="btn btn-primary btn-lg" style="flex:1" data-lead-open>Request pricing</a>
  </div>
  <div class="lead-scrim" data-lead-close hidden></div>
</Base>

<script>
  import { initVendorPage } from '../../scripts/vendor-page';
  import { initShortlist } from '../../scripts/shortlist';
  initVendorPage();
  initShortlist();

  // Phones: the request form opens as a bottom sheet from the sticky bar (and from "Request pricing" links to #lead).
  const phone = matchMedia('(max-width: 900px)');
  const lead = document.getElementById('lead');
  const scrim = document.querySelector<HTMLElement>('.lead-scrim');
  const setLead = (on: boolean) => {
    lead?.classList.toggle('open', on);
    if (scrim) scrim.hidden = !on;
    document.body.classList.toggle('sheet-lock', on);
    if (on) setTimeout(() => lead?.querySelector<HTMLElement>('.lead-close')?.focus({ preventScroll: true }), 260);
  };
  document.querySelectorAll('[data-lead-open]').forEach((a) => a.addEventListener('click', (e) => { if (phone.matches) { e.preventDefault(); setLead(true); } }));
  document.querySelectorAll('[data-lead-close]').forEach((b) => b.addEventListener('click', () => setLead(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && lead?.classList.contains('open')) setLead(false); });
  if (location.hash === '#lead' && phone.matches) setLead(true);
</script>

<style>
  .gallery { margin-top: 16px; display: grid; grid-template-columns: repeat(4, 1fr); grid-template-rows: 190px 190px; gap: 10px; border-radius: 20px; overflow: hidden; }
  .gallery > * { width: 100%; height: 100%; object-fit: cover; }
  .gallery .big { grid-column: span 2; grid-row: span 2; }
  .layout { display: flex; flex-wrap: wrap; gap: 48px; align-items: flex-start; padding: 32px 0 64px; }
  .main { flex: 999 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 36px; }
  .main h2 { font-size: 34px; margin: 0 0 12px; }
  .contact { display: flex; flex-wrap: wrap; gap: 10px; }
  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(128px, 1fr)); gap: 12px; }
  .facts div { border: 1px solid var(--line); border-radius: 14px; padding: 16px; display: flex; flex-direction: column; gap: 4px; }
  .facts span { font-size: 13px; color: var(--ink-3); } .facts b { font-size: 18px; }
  .tabs { display: flex; gap: 28px; border-bottom: 1px solid var(--line); font-weight: 600; }
  .tabs a { text-decoration: none; padding: 12px 0; }
  .amen { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px 24px; font-size: 15px; }
  .amen li::before { content: '✓'; color: var(--green); font-weight: 700; margin-right: 10px; }
  .det-group { border-top: 1px solid var(--line); padding: 16px 0 4px; display: flex; flex-direction: column; gap: 14px; }
  .det-group h3 { margin: 0; font-size: 18px; }
  .det-row { display: flex; flex-direction: column; gap: 8px; }
  .det-row b { font-size: 14px; color: var(--ink-2); }
