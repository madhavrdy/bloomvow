---
import Base from '../../../../../layouts/Base.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';
import VendorRow from '../../../../../components/VendorRow.astro';
import AdSlot from '../../../../../components/AdSlot.astro';
import { getData, money, type ListingPage } from '../../../../../lib/data';
import Guides from '../../../../../components/Guides.astro';
import { venueFaqs } from '../../../../../lib/venueFaqs';
import { listingFaqs, listingIntro, faqJsonLd, breadcrumbJsonLd, itemListJsonLd } from '../../../../../lib/seo';
import { kmBetween, niceRound } from '../../../../../lib/geo';
import { PAGE_SIZE } from '../../../../../lib/constants';
import Intro from '../../../../../components/Intro.astro';
import Guide from '../../../../../components/Guide.astro';
import { contentFor, mergeFaqs, latest, fmtDay } from '../../../../../lib/content';
import { listingSummary } from '../../../../../lib/seo';
import type { Style } from '../../../../../lib/styles';

export async function getStaticPaths() {
  const d = await getData();
  return d.listings.flatMap((l) => {
    const pages = Math.max(1, Math.ceil(l.vendors.length / PAGE_SIZE));
    return Array.from({ length: pages }, (_, i) => ({
      params: { country: l.country.code, region: l.region.slug, city: l.city.slug, category: l.category.slug, page: i === 0 ? undefined : `page/${i + 1}` },
      props: { listing: l, pageNo: i + 1, pages, style: undefined as Style | undefined },
    }));
  }).concat(d.styleListings.map((x) => ({
    params: { country: x.listing.country.code, region: x.listing.region.slug, city: x.listing.city.slug, category: x.listing.category.slug, page: x.style.slug as string | undefined },
    props: { listing: x.listing, pageNo: 1, pages: 1, style: x.style },
  })));
}

interface Props { listing: ListingPage; pageNo: number; pages: number; style?: Style }
const { listing: l, pageNo, pages, style } = Astro.props;
const d = await getData();
const { city, region, category: cat } = l;
const styleList = style ? d.styleListings.find((x) => x.listing === l && x.style.slug === style.slug)! : null;
const all = styleList ? styleList.vendors : l.vendors;            // every vendor this page is about
const vendors = styleList ? all.slice(0, PAGE_SIZE) : l.vendors.slice((pageNo - 1) * PAGE_SIZE, pageNo * PAGE_SIZE);
const path = styleList ? styleList.url : pageNo === 1 ? l.url : `${l.url}page/${pageNo}/`;
const c = contentFor(d, path, Astro.site?.host);
const styles = d.styleListings.filter((x) => x.listing === l);
const st = region.code.toUpperCase();
const heading = style ? `${style.label} ${cat.name.toLowerCase()} in ${city.name}, ${st}` : `${cat.name} in ${city.name}, ${st}`;
// Pages 2+ get their own title and H1, so search engines treat page 1 as the main page for the query.
const pageHeading = pageNo > 1 ? `${heading} – Page ${pageNo}` : heading;
const title = c.seoTitle ?? (pageNo > 1 ? `${heading} – Page ${pageNo} of ${pages}` : heading);
const autoIntro = style
  ? `${all.length} ${style.label.toLowerCase()} ${cat.name.toLowerCase()} in and around ${city.name}. Compare pricing and capacity, then request quotes from several at once.`
  : listingIntro(l);
const glance = pageNo === 1 ? listingSummary(d, l, all, style?.label) : [];
const updated = latest(all.reduce((m, v) => (v.updated_at > m ? v.updated_at : m), ''), c.updatedAt);

const crumbs = [
  { name: 'Home', url: '/' },
  { name: region.name, url: d.urls.region(region) },
  { name: city.name, url: d.urls.city(city) },
  ...(style ? [{ name: cat.name, url: l.url }, { name: style.label }]
    : pageNo > 1 ? [{ name: cat.name, url: l.url }, { name: `Page ${pageNo}` }] : [{ name: cat.name }]),
];

// Price filter bands from this page's own prices (quartiles, rounded).
const prices = l.vendors.map((v) => v.price_from).filter((p): p is number => p != null).sort((a, b) => a - b);
const q = (f: number) => niceRound(prices[Math.floor((prices.length - 1) * f)] ?? 0);
const cuts = prices.length >= 8 ? [...new Set([q(0.25), q(0.5), q(0.75)])].filter((x) => x > 0) : [];
const priceBands = cuts.length ? cuts.map((c, i) => ({ min: i ? cuts[i - 1] : 0, max: c })).concat([{ min: cuts[cuts.length - 1], max: 0 }]) : [];
const settings = [...new Set(l.vendors.map((v) => v.setting).filter(Boolean))] as string[];

const otherCats = (d.listingsByCity.get(city.id) ?? []).filter((x) => x.category.id !== cat.id).slice(0, 8);
const nearby = (d.listingsByCategory.get(cat.id) ?? [])
  .filter((x) => x.city.id !== city.id && x.country.code === l.country.code && city.lat != null && x.city.lat != null)
  .map((x) => ({ x, km: kmBetween(city.lat!, city.lng!, x.city.lat!, x.city.lng!) }))
  .filter((o) => o.km < 160).sort((a, b) => a.km - b.km).slice(0, 6).map((o) => o.x);

// FAQs (first page only). Venue pages get the 8 location FAQs built from this city's own listings.
const autoFaqs = style ? [] : cat.slug === 'wedding-venues'
  ? venueFaqs({ l, top: l.vendors.filter((v) => v.featured || v.status === 'claimed' || (v.rating ?? 0) > 0).slice(0, 3), styles: styles.map((x) => ({ style: x.style, url: x.url, count: x.vendors.length })), nearby, otherCats, vendorUrl: d.urls.vendor })
  : listingFaqs(l);
const faqs = pageNo === 1 ? mergeFaqs(c.faqs, autoFaqs) : [];

const jsonld = [breadcrumbJsonLd(Astro.site, crumbs), itemListJsonLd(Astro.site, d, vendors, (pageNo - 1) * PAGE_SIZE), ...(faqs.length ? [faqJsonLd(faqs)] : []),
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: pageHeading, url: new URL(path, Astro.site).href, ...(updated ? { dateModified: updated } : {}) }];
const ogImage = c.hero?.url ?? vendors.map((v) => d.photosByVendor.get(v.id)?.[0]?.url).find(Boolean);
const pageUrl = (n: number) => (n === 1 ? l.url : `${l.url}page/${n}/`);
---
<Base title={title} description={pageNo > 1 ? `Page ${pageNo} of ${pages}: ${heading}. ${autoIntro}`.slice(0, 158) : c.seoDescription ?? autoIntro.slice(0, 158)}
  noindex={style ? false : !l.indexable} jsonld={jsonld} image={ogImage}
  prev={!style && pageNo > 1 ? pageUrl(pageNo - 1) : undefined} next={!style && pageNo < pages ? pageUrl(pageNo + 1) : undefined}>
  <main class="wrap" style="padding-top:24px">
    <Breadcrumbs items={crumbs} />
    <h1 class="serif" style="font-size:clamp(36px,5vw,52px);margin:16px 0 8px">{pageHeading}</h1>
    {pageNo === 1
      ? <Intro c={c} auto={autoIntro} />
      : <p class="muted page-intro">Page {pageNo} of {pages}. Start with the <a href={l.url}>top {cat.name.toLowerCase()} in {city.name}, {st}</a>.</p>}
    {updated && <p class="updated">Last updated <time datetime={updated}>{fmtDay(updated)}</time></p>}
    {glance.length > 0 && (
      <details class="glance" id="glance" open>
        <summary><h2 id="glance-h">At a glance</h2><span class="glance-sub">{glance[0]}</span></summary>
        <ul>{glance.map((g) => <li>{g}</li>)}</ul>
      </details>
    )}
    {styles.length > 0 && (
      <nav class="styles-nav" aria-label="Venue styles"><a href={l.url} aria-current={!style ? 'page' : undefined}>All</a>
        {styles.map((x) => <a href={x.url} aria-current={style?.slug === x.style.slug ? 'page' : undefined}>{x.style.label} ({x.vendors.length})</a>)}</nav>
    )}

    <AdSlot placement="city_top" city={city.id} category={cat.id} />
    <div class="layout">
      <aside class="filters" id="filter-sheet" aria-label="Filters">
        <div class="sheet-head"><b>Filters</b><span style="display:flex;gap:16px;align-items:center"><button type="reset" form="filters" class="linkish">Clear all</button><button type="button" class="icon-btn" data-close-filters aria-label="Close filters">✕</button></span></div>
        <form id="filters">
          {style && <input type="hidden" name="style" value={style.slug} />}
          <div class="filters-title" style="display:flex;justify-content:space-between;align-items:center"><b style="font-size:17px">Filters</b><button type="reset" class="linkish">Clear all</button></div>
          {cat.uses_capacity && (
            <fieldset><legend>Guest count</legend>
              {[[0, 'Any'], [50, 'Up to 50'], [100, '51–100'], [200, '101–200'], [201, '200+']].map(([v, t], i) => (
                <label class="check"><input type="radio" name="guests" value={v} checked={i === 0} /> {t}</label>
              ))}
            </fieldset>
          )}
          {priceBands.length > 0 && (
            <fieldset><legend>Starting price</legend>
              {priceBands.map((b) => <label class="check"><input type="checkbox" name="price" value={`${b.min}-${b.max}`} /> {b.max ? `${b.min ? money(b.min) + '–' : 'Under '}${money(b.max)}` : `${money(b.min)}+`}</label>)}
            </fieldset>
          )}
          {settings.length > 1 && (
            <fieldset><legend>Setting</legend>
              {settings.map((s) => <label class="check"><input type="checkbox" name="setting" value={s} /> {s}</label>)}
            </fieldset>
          )}
          <fieldset><legend>Rating</legend><label class="check"><input type="checkbox" name="rating" value="4.5" /> 4.5 stars and up</label></fieldset>
        </form>
        <div class="save-time">
          <b>Save time</b>
          <span>Send one request to the {cat.name.toLowerCase()} that fit your date and budget.</span>
          <a href={`/get-matched/?city=${city.id}&cat=${cat.slug}&mode=bulk`} class="btn btn-primary btn-block">Request pricing from several</a>
        </div>
        <button type="button" class="btn btn-primary btn-block sheet-done" data-close-filters>Show results</button>
      </aside>
      <div class="sheet-scrim" data-close-filters hidden></div>

      <section class="results" aria-label="Results">
        <div class="results-head">
          <span class="muted" aria-live="polite"><b style="color:var(--ink)" id="count">{all.length}</b> <span class="cnt-long">{cat.name.toLowerCase()}{pages > 1 && ` · page ${pageNo} of ${pages}`}</span><span class="cnt-short">results</span></span>
          <button type="button" class="btn btn-outline filter-btn" id="filters-open" aria-controls="filter-sheet" aria-expanded="false">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4"/></svg>
            Filters<span class="fcount" id="fcount" hidden></span>
          </button>
          <label class="sort-wrap"><span class="sort-label">Sort by</span>
            <select id="sort" class="sort"><option value="rec">Recommended</option><option value="rating">Highest rated</option><option value="price">Price: low to high</option><option value="reviews">Most reviewed</option></select>
          </label>
        </div>
        <div id="list" class="list" data-total={all.length} data-city={city.id} data-cat={cat.id} data-st={st}>
          {vendors.map((v, i) => (
            <div class="item" data-i={i} data-cap={v.capacity_max ?? ''} data-price={v.price_from ?? ''} data-setting={v.setting ?? ''} data-rating={v.rating ?? 0} data-reviews={v.review_count} hidden={i >= 20}>
              <VendorRow v={v} index={i} />
              {i === 5 && <AdSlot placement="city_list" city={city.id} category={cat.id} class="in-list" />}
              {i === 2 && (
                <div class="match-card">
                  <div><span class="serif" style="font-size:30px">Too many options?</span>
                  <p style="margin:6px 0 0;color:#d9d4e2">Answer 4 quick questions and we'll send your request to the {cat.name.toLowerCase()} that fit your date and budget.</p></div>
                  <a href={`/get-matched/?city=${city.id}&cat=${cat.slug}`} class="btn btn-lg" style="background:var(--rose-tint);color:var(--ink)">Get matched free</a>
                </div>
              )}
            </div>
          ))}
        </div>
        <p id="empty" class="muted" hidden>No {cat.name.toLowerCase()} match these filters. <button type="button" class="linkish" id="clear2">Clear filters</button></p>
        {vendors.length > 20 && <button type="button" id="more" class="btn btn-outline btn-block">Show more</button>}
        {pages > 1 && (
          <nav class="pager" aria-label="Pagination">
            {Array.from({ length: pages }, (_, i) => i + 1).map((n) => <a href={pageUrl(n)} aria-current={n === pageNo ? 'page' : undefined}>{n}</a>)}
          </nav>
        )}
      </section>
    </div>
  </main>
  {pageNo === 1 && <Guide c={c} title={`${heading}: the guide`} />}
  <main class="wrap">
    {pageNo === 1 && <Guides cityId={city.id} categoryId={cat.id} title={`Planning guides: ${cat.name.toLowerCase()} in ${city.name}`} />}
  </main>

  <section class="bg2">
    <div class="wrap faqwrap">
      {faqs.length > 0 && (
        <div style="flex:2 1 520px">
          <h2 class="serif" style="font-size:36px;margin:0 0 8px">{style ? heading : `${city.name} ${cat.name.toLowerCase()}`}: FAQs</h2>
          {faqs.map((f, i) => (
            <details class="faq" open={i === 0}><summary>{f.q}</summary><p>{f.a}</p>
              {f.links && f.links.length > 0 && <p class="faq-links">{f.links.map((x) => <a href={x.href}>{x.label}</a>)}</p>}
            </details>
          ))}
        </div>
      )}
      <div style="flex:1 1 260px;display:flex;flex-direction:column;gap:28px;font-size:15px">
        {otherCats.length > 0 && <div class="rel"><b>More {city.name} vendors</b>{otherCats.map((x) => <a href={x.url}>{city.name} {x.category.name.toLowerCase()}</a>)}</div>}
        {nearby.length > 0 && <div class="rel"><b>{cat.name} near {city.name}</b>{nearby.map((x) => <a href={x.url}>{cat.name} in {x.city.name}</a>)}</div>}
      </div>
    </div>
  </section>
</Base>

<script>
  import { initListing } from '../../../../../scripts/listing';
  import { initShortlist } from '../../../../../scripts/shortlist';
  initListing();
  initShortlist();

  // Phones: "At a glance" starts collapsed so the results show first; filters open as a bottom sheet.
  const small = matchMedia('(max-width: 900px)');
  const glance = document.getElementById('glance') as HTMLDetailsElement | null;
  if (glance && small.matches) glance.open = false;
  const sheet = document.getElementById('filter-sheet');
  const openBtn = document.getElementById('filters-open');
  const scrim = document.querySelector<HTMLElement>('.sheet-scrim');
  const setOpen = (on: boolean) => {
    sheet?.classList.toggle('open', on);
    if (scrim) scrim.hidden = !on;
    openBtn?.setAttribute('aria-expanded', String(on));
    document.body.classList.toggle('sheet-lock', on);
    if (on) sheet?.querySelector<HTMLElement>('input, button')?.focus();
    else openBtn?.focus({ preventScroll: true });
  };
  openBtn?.addEventListener('click', () => setOpen(true));
  document.querySelectorAll('[data-close-filters]').forEach((b) => b.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && sheet?.classList.contains('open')) setOpen(false); });
  // Count of active filters on the button.
  const form = document.getElementById('filters') as HTMLFormElement | null;
  const fcount = document.getElementById('fcount');
  const count = () => {
    if (!form || !fcount) return;
    const n = [...form.querySelectorAll<HTMLInputElement>('input:checked')].filter((i) => !(i.type === 'radio' && i.value === '0')).length;
    fcount.textContent = String(n); fcount.hidden = n === 0;
  };
  form?.addEventListener('change', count); form?.addEventListener('reset', () => setTimeout(count));
</script>

<style>
  .layout { display: flex; flex-wrap: wrap; gap: 32px; align-items: flex-start; padding: 28px 0 48px; }
  .filters { position: sticky; top: calc(var(--header-h) + 16px); }
  .sheet-head, .sheet-done, .filter-btn { display: none; }
  .sort-wrap { display: flex; gap: 8px; align-items: center; font-size: 15px; }
  .cnt-short { display: none; }
  .fcount { background: var(--rose); color: #fff; border-radius: 999px; font-size: 12px; min-width: 20px; height: 20px; display: inline-flex; align-items: center; justify-content: center; padding: 0 6px; }
  .filters { flex: 1 1 240px; max-width: 280px; display: flex; flex-direction: column; gap: 24px; font-size: 15px; }
  .filters form { display: flex; flex-direction: column; gap: 24px; }
  fieldset { border: 0; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
  legend { font-weight: 700; margin-bottom: 10px; }
  .linkish { background: none; border: 0; padding: 0; font: inherit; font-size: 14px; text-decoration: underline; cursor: pointer; color: var(--ink); }
  .save-time { background: var(--rose-soft); border-radius: 16px; padding: 20px; display: flex; flex-direction: column; gap: 10px; font-size: 14px; color: var(--ink-2); }
  .save-time b { color: var(--ink); font-size: 16px; }
  .results { flex: 999 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 20px; }
  .results-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; }
  .sort { font: inherit; border: 1px solid var(--line-2); border-radius: 10px; padding: 0 12px; min-height: 44px; background: #fff; }
  .list { display: flex; flex-direction: column; gap: 20px; }
  .item { display: flex; flex-direction: column; gap: 20px; }
  .match-card { background: var(--ink); color: #fff; border-radius: 20px; padding: 28px; display: flex; flex-wrap: wrap; gap: 20px; align-items: center; justify-content: space-between; }
  .match-card > div { flex: 1 1 320px; }
  .pager { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; }
  .pager a { min-width: 44px; min-height: 44px; border-radius: 12px; border: 1px solid var(--line-2); display: inline-flex; align-items: center; justify-content: center; text-decoration: none; }
  .pager a[aria-current] { background: var(--ink); color: #fff; border-color: var(--ink); }
  .bg2 { background: var(--bg-2); }
  .faq-links { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 14px; margin-top: 8px !important; }
  .faq-links a { color: var(--rose-dark); font-weight: 600; }
  .faqwrap { display: flex; flex-wrap: wrap; gap: 48px; padding-top: 56px; padding-bottom: 56px; }
  .rel { display: flex; flex-direction: column; gap: 10px; } .rel b { font-size: 17px; }
  @media (max-width: 900px) {
    .layout { padding-top: 16px; gap: 0; }
    .results { flex-basis: 100%; }
    /* Filters become a bottom sheet. */
    .filters { position: fixed; z-index: 60; left: 0; right: 0; bottom: 0; top: auto; max-width: none; max-height: 85vh; overflow: auto;
      background: #fff; border-radius: 22px 22px 0 0; padding: 8px 20px 20px; box-shadow: 0 -20px 50px rgba(31, 26, 46, .2);
      transform: translateY(105%); transition: transform .25s ease; visibility: hidden; }
    .filters.open { transform: none; visibility: visible; }
    .sheet-head { display: flex; justify-content: space-between; align-items: center; position: sticky; top: -8px; background: #fff; padding: 10px 0; z-index: 1; }
    .sheet-head b { font-size: 18px; }
    .filters-title { display: none !important; }
    .cnt-long { display: none; } .cnt-short { display: inline; }
    .sheet-done { display: inline-flex; position: sticky; bottom: 0; }
    .sheet-scrim { position: fixed; inset: 0; z-index: 55; background: rgba(31, 26, 46, .4); }
    :global(body.sheet-lock) { overflow: hidden; }
    .filter-btn { display: inline-flex; min-height: 40px; padding: 0 14px; font-size: 14px; }
    /* Sticky bar with count, Filters and Sort under the header. */
    .results-head { position: sticky; top: var(--header-h); z-index: 20; background: rgba(255, 255, 255, .96); margin: 0 -16px; padding: 10px 16px;
      border-bottom: 1px solid var(--line); flex-wrap: nowrap; }
    .results-head > span { flex: 1; font-size: 14px; }
    .sort-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .sort { min-height: 40px; font-size: 14px; max-width: 150px; }
    .list, .item { gap: 12px; }
    .match-card { padding: 20px; border-radius: 16px; }
    .match-card .serif { font-size: 24px !important; }
    .faqwrap { padding-top: 40px; padding-bottom: 40px; gap: 32px; }
  }
</style>
