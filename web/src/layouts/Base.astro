---
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/plus-jakarta-sans';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_NAME, SUPABASE_URL, SUPABASE_ANON_KEY, CONTACT_EMAIL } from '../config';
import { getData } from '../lib/data';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  jsonld?: object[];
  image?: string;
  bare?: boolean;   // no header/footer (quote flow, dashboards)
  rss?: boolean;    // link the blog RSS feed
  ogType?: string;
}
const { title, description, noindex = false, jsonld = [], image, bare = false, rss = false, ogType = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = title.includes(SITE_NAME) ? title : `${title} | ${SITE_NAME}`;
const ogImage = new URL(image ?? '/og-default.png', Astro.site).href;
// hreflang: country pages declare their language-region; the homepage points to each live country.
const d = await getData();
const cc = Astro.url.pathname.match(/^\/([a-z]{2})\//)?.[1];
const langs: { lang: string; href: string }[] = Astro.url.pathname === '/'
  ? [{ lang: 'x-default', href: canonical }, ...d.countries.map((c) => ({ lang: `en-${c.code}`, href: new URL(`/${c.code}/`, Astro.site).href }))]
  : cc && d.countryByCode.has(cc) ? [{ lang: `en-${cc}`, href: canonical }] : [];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  {!image && <meta property="og:image:width" content="1200" />}{!image && <meta property="og:image:height" content="630" />}
  {langs.map((l) => <link rel="alternate" hreflang={l.lang} href={l.href} />)}
  <meta name="twitter:card" content="summary_large_image" />
  {rss && <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} blog`} href="/blog/rss.xml" />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href={SUPABASE_URL} crossorigin />
  <meta name="bv-api" content={SUPABASE_URL} data-key={SUPABASE_ANON_KEY} data-contact={CONTACT_EMAIL} />
  {jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
</head>
<body>
  {!bare && <Header />}
  <slot />
  {!bare && <Footer />}
  {!bare && !noindex && <script>import '../scripts/pageview';</script>}
</body>
</html>
