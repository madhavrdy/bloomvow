---
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/plus-jakarta-sans';
import '@fontsource/outfit/300.css';
import '@fontsource/outfit/700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Tracking from '../components/Tracking.astro';
import TrackingBody from '../components/TrackingBody.astro';
import { SITE_NAME, SUPABASE_URL, SUPABASE_ANON_KEY, CONTACT_EMAIL, PREVIEW } from '../config';
import { getData } from '../lib/data';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  jsonld?: object[];
  image?: string;
  bare?: boolean;   // no header/footer (quote flow, dashboards)
  rss?: boolean;    // link the blog RSS feed
  ogType?: string;
  prev?: string;    // paginated lists: path of the previous / next page
  next?: string;
}
const { title, description, noindex = false, jsonld = [], image, bare = false, rss = false, ogType = 'website', prev, next } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = title.includes(SITE_NAME) ? title : `${title} | ${SITE_NAME}`;
const ogImage = new URL(image ?? '/og-default.png', Astro.site).href;
// hreflang: country pages declare their language-region; the homepage points to each live country.
const d = await getData();
const cc = Astro.url.pathname.match(/^\/([a-z]{2})\//)?.[1];
const langs: { lang: string; href: string }[] = Astro.url.pathname === '/'
  ? [{ lang: 'x-default', href: canonical }, ...d.countries.map((c) => ({ lang: `en-${c.code}`, href: new URL(`/${c.code}/`, Astro.site).href }))]
  : cc && d.countryByCode.has(cc) ? [{ lang: `en-${cc}`, href: canonical }] : [];
// Tracking tags on the public site only: not on preview builds, the admin or the vendor dashboard.
const tags = !PREVIEW && !/^\/(back-end|vendor-dashboard)\//.test(Astro.url.pathname);
// AdSense: the ownership tag Google looks for when you add the site (Admin > Ads).
const adClient = d.ads.client;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {prev && <link rel="prev" href={new URL(prev, Astro.site).href} />}
  {next && <link rel="next" href={new URL(next, Astro.site).href} />}
  {PREVIEW ? <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" /> : noindex && <meta name="robots" content="noindex, follow" />}
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  {!image && <meta property="og:image:width" content="1200" />}{!image && <meta property="og:image:height" content="630" />}
  {langs.map((l) => <link rel="alternate" hreflang={l.lang} href={l.href} />)}
  <meta name="twitter:card" content="summary_large_image" />
  {rss && <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} blog`} href="/blog/rss.xml" />}
  <!-- Icons from the chosen logo (Mandap Arch, plum tile). Bump ?v= when they change so browsers and the CDN refetch. -->
  <link rel="icon" href="/favicon.ico?v=3" sizes="48x48" />
  <link rel="icon" href="/favicon.svg?v=3" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />
  <link rel="manifest" href="/site.webmanifest?v=3" />
  <meta name="theme-color" content="#ffffff" />
  <link rel="preconnect" href={SUPABASE_URL} crossorigin />
  <meta name="bv-api" content={SUPABASE_URL} data-key={SUPABASE_ANON_KEY} data-contact={CONTACT_EMAIL} />
  {tags && <Tracking t={d.tracking} />}
  {tags && adClient && <meta name="google-adsense-account" content={adClient} />}
  {jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
</head>
<body>
  {tags && <TrackingBody t={d.tracking} />}
  {!bare && <Header />}
  <slot />
  {!bare && <Footer />}
  {!bare && !noindex && <script>import '../scripts/pageview';</script>}
</body>
</html>
