# Hostinger (Apache/LiteSpeed) settings for the static site.
ErrorDocument 404 /404.html
DirectoryIndex index.html
Options -Indexes

# Always use https and the www-less / www host chosen at launch (set SITE_URL to match).
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

<IfModule mod_headers.c>
  # Hashed build assets never change: cache for a year.
  # Copied photos (/media/) have unique names and never change either.
  <If "%{REQUEST_URI} =~ m#^/(_astro|media)/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.(html|xml|json)$">
    Header set Cache-Control "public, max-age=600, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml application/rss+xml image/svg+xml
</IfModule>
